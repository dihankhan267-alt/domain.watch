# Copy this to .env and fill in when you're ready to go live.
# Locally, the app needs at least DATABASE_URL to run at all now
# (storage moved from a JSON file to Postgres — see README).

# Postgres connection string. Supabase: Project Settings -> Database ->
# Connection string -> URI (use the "Session pooler" one for most hosts).
DATABASE_URL=

# Shared secret for the /api/cron/daily and /api/cron/weekly HTTP
# triggers, used only if your host has no free scheduled-job feature.
# Any long random string works. Leave blank to disable those routes.
CRON_SECRET=

# Resend (resend.com) - free tier: 3,000 emails/month
RESEND_API_KEY=
FROM_EMAIL=alerts@yourdomain.com

# Stripe - for real billing once you have paying users
STRIPE_SECRET_KEY=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_AGENCY=

PORT=3000
